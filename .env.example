# Copy to .env. Loaded by `python -m factotum …` and by deploy/factotum.service (EnvironmentFile=).
# Everything secret lives here; everything structural lives in config/factotum.yaml.

# Which config file to load (default: config/factotum.yaml, falling back to config/factotum.example.yaml)
FACTOTUM_CONFIG=config/factotum.yaml
# SQLite database path
FACTOTUM_DB=data/factotum.db
# Random string used to sign reminder-action tokens (phase 2). `openssl rand -hex 32`
FACTOTUM_SECRET=

# Notion internal integration secret (docs/SETUP.md §5). Needed for import, the notes sink, the task mirror.
NOTION_TOKEN=

# Mailbird Next MCP bearer token (docs/SETUP.md §3). Phase 4.
MAILBIRD_TOKEN=

# ntfy.sh access token, optional on the public server for an unreserved topic (docs/SETUP.md §4). Phase 2.
NTFY_TOKEN=

# Canvas personal access token (phase 4)
CANVAS_TOKEN=

# Outgoing mail for the morning brief (phase 2). Leave empty to reuse the IMAP account below (a Gmail app
# password works for both). The brief is sent from SMTP_USER to notify.morning_brief.to in the config.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# IMAP account that receives the Plaud AutoFlow emails (phase 3). Gmail app password, not the login password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
